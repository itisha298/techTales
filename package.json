{
  "name": "meridian-prime-meridian",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "present": "npm run build && npm run serve",
    "images": "node scripts/optimize-team-images.mjs",
    "serve": "vite preview --port 4173 --strictPort --open",
    "extract": "python -I scripts/extract_docx.py source-assets/Meridian_4_Topics_Speeches.docx scripts/extracted.txt",
    "check": "npm run validate:content && npm run lint && npm run typecheck && npm test && npm run build",
    "validate:content": "node scripts/validate-content.ts",
    "images:opening": "node scripts/extract-opening-artwork.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "framer-motion": "^14.6.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.18"
  }
}
